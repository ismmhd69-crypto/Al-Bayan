  {
    "id": "806adfbe-4569-4882-9cdd-b346f1b70529",
    "url": "https://sunnah.com/bukhari:3607",
    "start": "قَالَ تَعَلَّمَ أَصْحَابِي الْخَيْرَ وَتَعَلَّمْتُ الشَّرَّ",
