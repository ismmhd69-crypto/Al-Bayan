  },
  {
    "id": "53a2395e-2ae8-47db-8d35-e00876c33fd1",
    "url": "https://sunnah.com/bukhari:3610",
    "start": "قَالَ بَيْنَمَا نَحْنُ عِنْدَ رَسُولِ اللَّهِ صلى الله عليه وسلم وَهْوَ يَقْسِمُ قَسْمًا أَتَاهُ ذُو الْخُوَيْصِرَةِ ـ وَهْوَ رَجُلٌ مِنْ بَنِي تَمِيمٍ ـ فَقَالَ يَا رَسُولَ اللَّهِ اعْدِلْ",
    "kind": "prophet_words"
  },
  {
    "id": "5462cfce-33ad-4c48-b393-7caefc8f1256",
    "url": "https://sunnah.com/bukhari:3615",
    "start": "قَالَ لِعَازِبٍ ابْعَثِ ابْنَكَ يَحْمِلْهُ مَعِي",
    "kind": "dialogue"
  },
  {
    "id": "a58bee01-7354-4855-a15a-61a3d7efe7cf",
    "url": "https://sunnah.com/bukhari:3616",
    "start": "أَنَّ النَّبِيَّ صلى الله عليه وسلم دَخَلَ عَلَى أَعْرَابِيٍّ ـ يَعُودُهُ ـ قَالَ وَكَانَ النَّبِيُّ صلى الله عليه وسلم إِذَا دَخَلَ عَلَى مَرِيضٍ يَعُودُهُ قَالَ لاَ بَأْسَ طَهُورٌ إِنْ شَاءَ اللَّهُ",
    "kind": "companion_words"
  },
  {
    "id": "c72917d1-6faa-4c90-b7f5-978b80fb8ace",
    "url": "https://sunnah.com/bukhari:3617",
    "start": "كَانَ يَقُولُ مَا يَدْرِي مُحَمَّدٌ إِلاَّ مَا كَتَبْتُ لَهُ",
    "kind": "companion_words"
  },
  {
    "id": "a1037bf0-5819-4a21-b6ac-69091bf65880",
    "url": "https://sunnah.com/bukhari:3620",
    "start": "قَالَ قَدِمَ مُسَيْلِمَةُ الْكَذَّابُ عَلَى عَهْدِ رَسُولِ اللَّهِ صلى الله عليه وسلم فَجَعَلَ يَقُولُ إِنْ جَعَلَ لِي مُحَمَّدٌ الأَمْرَ مِنْ بَعْدِهِ تَبِعْتُهُ",
    "kind": "companion_words"
  },
  {
    "id": "b7e9ee34-4273-46f2-95f2-839b7b638ec7",
    "url": "https://sunnah.com/bukhari:3623",
    "start": "قَالَ النَّبِيُّ صلى الله عليه وسلم ",
    "kind": "companion_words"
