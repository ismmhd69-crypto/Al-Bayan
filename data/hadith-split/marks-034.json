[
  {
    "id": "39b45719-b904-41b2-ae07-9a714e7cc8fe",
    "url": "https://sunnah.com/bukhari:3561",
    "start": "وَلاَ شَمِمْتُ رِيحًا قَطُّ أَوْ عَرْفًا قَطُّ أَطْيَبَ مِنْ رِيحِ أَوْ عَرْفِ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "3df90a9a-54c9-46cf-848d-66bc1b8c5422",
    "url": "https://sunnah.com/bukhari:3562",
    "start": "كَانَ النَّبِيُّ صلى الله عليه وسلم أَشَدَّ حَيَاءً مِنَ الْعَذْرَاءِ فِي خِدْرِهَا",
    "kind": "prophet_words"
  },
  {
    "id": "9d5e32ad-138c-44d9-8dfb-62409cece35f",
    "url": "https://sunnah.com/bukhari:3562b",
    "start": "مِثْلَهُ وَإِذَا كَرِهَ شَيْئًا عُرِفَ فِي وَجْهِهِ",
    "kind": "companion_words"
  },
  {
    "id": "df174b6e-7bb9-41da-80f8-4c4f5206c35b",
    "url": "https://sunnah.com/bukhari:3563",
    "start": "إِنِ اشْتَهَاهُ أَكَلَهُ",
    "kind": "companion_words"
  },
  {
    "id": "1a28d49f-559c-4a00-9e03-22992bda41b6",
    "url": "https://sunnah.com/bukhari:3564",
    "start": "قَالَ وَقَالَ ابْنُ بُكَيْرٍ حَدَّثَنَا بَكْرٌ بَيَاضَ إِبْطَيْهِ",
    "kind": "narration"
  },
  {
    "id": "9396b272-a729-49ff-ae1f-3a8bec0fcca2",
    "url": "https://sunnah.com/bukhari:3565",
    "start": "قَالَ أَبُو مُوسَى دَعَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَرَفَعَ يَدَيْهِ وَرَأَيْتُ بَيَاضَ إِبْطَيْهِ",
    "kind": "narration"
  },
  {
    "id": "d2c5cc7c-9d5b-427a-b570-4535c5576b6f",
    "url": "https://sunnah.com/bukhari:3566",
    "start": "دَخَلَ فَأَخْرَجَ فَضْلَ وَضُوءِ رَسُولِ اللَّهِ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "ab98f25d-b73b-43e8-b4e9-9b543227195d",
    "url": "https://sunnah.com/bukhari:3567",
    "start": "جَاءَ فَجَلَسَ إِلَى جَانِبِ حُجْرَتِي يُحَدِّثُ عَنْ رَسُولِ اللَّهِ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "48df799e-d26f-4e78-a8e0-aac467d99ed7",
    "url": "https://sunnah.com/bukhari:3570",
    "start": "أَنْ يُوحَى إِلَيْهِ",
    "kind": "companion_words"
  },
  {
    "id": "ff81a79e-b0c0-43bc-b178-c9b1016aeb40",
    "url": "https://sunnah.com/bukhari:3571",
    "start": "كَانَ وَجْهُ الصُّبْحِ عَرَّسُوا فَغَلَبَتْهُمْ أَعْيُنُهُمْ حَتَّى ارْتَفَعَتِ الشَّمْسُ",
    "kind": "narration"
  },
  {
    "id": "237246e6-2571-4882-b32e-7ff3c4fa9c76",
    "url": "https://sunnah.com/bukhari:3572",
    "start": "قَالَ ثَلاَثَمِائَةٍ",
    "kind": "narration"
  },
  {
    "id": "36ec2d7f-6485-4580-9abb-d9d3efb14045",
    "url": "https://sunnah.com/bukhari:3573",
    "start": "قَالَ رَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم وَحَانَتْ صَلاَةُ الْعَصْرِ",
    "kind": "narration"
  },
  {
    "id": "7d48ae20-76c5-4203-98f6-33f876ad538c",
    "url": "https://sunnah.com/bukhari:3574",
    "start": "جَاءَ بِقَدَحٍ مِنْ مَاءٍ يَسِيرٍ فَأَخَذَهُ النَّبِيُّ صلى الله عليه وسلم فَتَوَضَّأَ",
    "kind": "companion_words"
  },
  {
    "id": "8b683894-db4e-4877-991f-50bc3f411b2d",
    "url": "https://sunnah.com/bukhari:3575",
    "start": "أَنْ يَبْسُطَ فِيهِ كَفَّهُ",
    "kind": "companion_words"
  },
  {
    "id": "2ccb28fa-4a13-45a6-83fd-e770a0f10bc8",
    "url": "https://sunnah.com/bukhari:3577",
    "start": "فَجَلَسَ النَّبِيُّ صلى الله عليه وسلم عَلَى شَفِيرِ الْبِئْرِ",
    "kind": "companion_words"
  },
  {
    "id": "0677d032-8b49-4151-ab59-cd80f9d17303",
    "url": "https://sunnah.com/bukhari:3578",
    "start": "قَالَتْ نَعَمْ",
    "kind": "narration"
  },
  {
    "id": "71eed5db-9de9-4e6c-a756-dcd18f99fed0",
    "url": "https://sunnah.com/bukhari:3579",
    "start": "إِنَاءٍ فِيهِ مَاءٌ قَلِيلٌ",
    "kind": "narration"
  },
  {
    "id": "bae5cf48-f473-44e6-9fc7-a8594801d487",
    "url": "https://sunnah.com/bukhari:3583",
    "start": "لَمَّا اتَّخَذَ الْمِنْبَرَ تَحَوَّلَ إِلَيْهِ",
    "kind": "narration"
  },
  {
    "id": "43c7f35b-43ee-4e78-93a4-f5656b5198b4",
    "url": "https://sunnah.com/bukhari:3584",
    "start": "إِنْ شِئْتُمْ ",
    "kind": "companion_words"
  },
  {
    "id": "8e0fc331-be48-4932-bcce-bce5c1e4e8ed",
    "url": "https://sunnah.com/bukhari:3585",
    "start": "كَانَ الْمَسْجِدُ مَسْقُوفًا عَلَى جُذُوعٍ مِنْ نَخْلٍ فَكَانَ النَّبِيُّ صلى الله عليه وسلم إِذَا خَطَبَ يَقُومُ إِلَى جِذْعٍ مِنْهَا",
    "kind": "companion_words"
  },
  {
    "id": "6f678f0f-df17-466b-a9f3-f039f8f749cd",
    "url": "https://sunnah.com/bukhari:3587",
    "start": "أَنَّ وُجُوهَهُمُ الْمَجَانُّ الْمُطْرَقَةُ ",
    "kind": "prophet_words"
  },
