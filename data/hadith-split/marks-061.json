[
  {
    "id": "7a7a2918-9b23-472f-9b4d-ce603f39c3d9",
    "url": "https://sunnah.com/bukhari:6164",
    "start": "أَنَّ رَجُلاً، أَتَى رَسُولَ اللَّهِ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "d4a86b2c-18cf-4af8-8a10-148c181db66b",
    "url": "https://sunnah.com/bukhari:6165",
    "start": "أَنَّ أَعْرَابِيًّا قَالَ يَا رَسُولَ اللَّهِ",
    "kind": "dialogue"
  },
  {
    "id": "4761ca72-9d50-4099-9169-fd148bdc812a",
    "url": "https://sunnah.com/bukhari:6167",
    "start": "أَنَّ رَجُلاً، مِنْ أَهْلِ الْبَادِيَةِ أَتَى النَّبِيَّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "062c7530-ec25-496b-9a2a-28347204902a",
    "url": "https://sunnah.com/bukhari:6171",
    "start": "أَنَّ رَجُلاً، سَأَلَ النَّبِيَّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "d0dd1f97-9099-461d-93d8-910d63db399b",
    "url": "https://sunnah.com/bukhari:6172",
    "start": "قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم لاِبْنِ صَائِدٍ",
    "kind": "dialogue"
  },
  {
    "id": "aa4ad618-8935-452f-889a-9bd3d44c8f83",
    "url": "https://sunnah.com/bukhari:6173",
    "start": "أَنَّ عُمَرَ بْنَ الْخَطَّابِ انْطَلَقَ مَعَ رَسُولِ اللَّهِ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "297d6bf9-86eb-4e24-afaf-f42ba2893b9b",
    "url": "https://sunnah.com/bukhari:6176",
    "start": "قَالَ لَمَّا قَدِمَ وَفْدُ عَبْدِ الْقَيْسِ عَلَى النَّبِيِّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "9274125e-7b82-4bfc-b566-7707a2eb31d7",
    "url": "https://sunnah.com/bukhari:6185",
    "start": "أَنَّهُ أَقْبَلَ هُوَ وَأَبُو طَلْحَةَ مَعَ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "38c9ca00-5105-447c-a560-0ff770a16426",
    "url": "https://sunnah.com/bukhari:6190",
    "start": "أَنَّ أَبَاهُ، جَاءَ إِلَى النَّبِيِّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "d863ef39-fd12-4a6d-89ac-8f8e4925586a",
    "url": "https://sunnah.com/bukhari:6191",
    "start": "قَالَ أُتِيَ بِالْمُنْذِرِ بْنِ أَبِي أُسَيْدٍ إِلَى النَّبِيِّ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "8fc9ff6e-2273-4b5e-a560-f9717d72f5ce",
    "url": "https://sunnah.com/bukhari:6192",
    "start": "أَنَّ زَيْنَبَ، كَانَ اسْمُهَا بَرَّةَ",
    "kind": "dialogue"
  },
  {
    "id": "f45084e0-a08b-491e-bfb3-11a8120916ec",
    "url": "https://sunnah.com/bukhari:6193",
    "start": "قَالَ جَلَسْتُ إِلَى سَعِيدِ بْنِ الْمُسَيَّبِ",
    "kind": "dialogue"
  },
  {
    "id": "5ba184de-f7ac-4af5-a1b4-d9ec4c86d430",
    "url": "https://sunnah.com/bukhari:6194",
    "start": "قُلْتُ لاِبْنِ أَبِي أَوْفَى رَأَيْتَ إِبْرَاهِيمَ",
    "kind": "dialogue"
  },
  {
    "id": "4cb6ca32-4e62-46f6-88f0-a4f310da3f7e",
    "url": "https://sunnah.com/bukhari:6198",
    "start": "قَالَ وُلِدَ لِي غُلاَمٌ، فَأَتَيْتُ بِهِ النَّبِيَّ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "1b051b21-7ece-471f-b495-88cc750310c5",
    "url": "https://sunnah.com/bukhari:6199",
    "start": "قَالَ انْكَسَفَتِ الشَّمْسُ يَوْمَ مَاتَ إِبْرَاهِيمُ",
    "kind": "companion_words",
    "tail_start": "رَوَاهُ أَبُو بَكْرَةَ عَنِ النَّبِيِّ صلى الله عليه وسلم‏.‏"
  },
  {
    "id": "9e1b0d55-6f46-4e9f-a255-cdf12fba9ba1",
    "url": "https://sunnah.com/bukhari:6213",
    "start": "قَالَتْ عَائِشَةُ سَأَلَ أُنَاسٌ رَسُولَ اللَّهِ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "aa5166f0-3eab-48ac-a840-0e76a8d33505",
    "url": "https://sunnah.com/bukhari:6215",
    "start": "قَالَ بِتُّ فِي بَيْتِ مَيْمُونَةَ وَالنَّبِيُّ صلى الله عليه وسلم عِنْدَهَا",
    "kind": "narration"
  },
  {
    "id": "4f4a12b5-d700-4f13-a26f-cbe93940fafd",
    "url": "https://sunnah.com/bukhari:6216",
    "start": "أَنَّهُ كَانَ مَعَ النَّبِيِّ صلى الله عليه وسلم فِي حَائِطٍ",
    "kind": "narration"
  },
  {
    "id": "e3bdbfa4-3403-4fe5-8240-07108bca9085",
    "url": "https://sunnah.com/bukhari:6217",
    "start": "قَالَ كُنَّا مَعَ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "366625b5-2871-46ca-96b0-2893e96d01f3",
    "url": "https://sunnah.com/bukhari:6218",
    "start": "قَالَتِ اسْتَيْقَظَ النَّبِيُّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "b4cba4f9-9025-44bf-8a23-24a76b5824ba",
    "url": "https://sunnah.com/bukhari:6219",
    "start": "أَنَّ صَفِيَّةَ بِنْتَ حُيَىٍّ",
    "kind": "narration"
  },
  {
    "id": "a7f02c82-1037-4c34-b4b4-b639729fae9a",
    "url": "https://sunnah.com/bukhari:6222",
    "start": "قَالَ أَمَرَنَا النَّبِيُّ صلى الله عليه وسلم بِسَبْعٍ",
    "kind": "prophet_words"
  },
  {
    "id": "335745a8-8a48-437a-a7b3-d0de677e36ed",
    "url": "https://sunnah.com/bukhari:6229",
    "start": "أَنَّ النَّبِيَّ صلى الله عليه وسلم قَالَ ‏\"‏ إِيَّاكُمْ وَالْجُلُوسَ",
    "kind": "prophet_words"
  },
  {
    "id": "8b55e816-7028-4090-b488-ae54dfb971ee",
    "url": "https://sunnah.com/bukhari:6235",
    "start": "قَالَ أَمَرَنَا رَسُولُ اللَّهِ صلى الله عليه وسلم بِسَبْعٍ",
    "kind": "prophet_words"
  },
  {
    "id": "fef6c730-35d9-481d-8b59-12f09f03272d",
    "url": "https://sunnah.com/bukhari:6238",
    "start": "أَنَّهُ كَانَ ابْنَ عَشْرِ سِنِينَ",
    "kind": "companion_words"
  },
  {
    "id": "59b8a9c0-a930-4ab3-8ea0-f7bae683b7aa",
    "url": "https://sunnah.com/bukhari:6239",
    "start": "قَالَ لَمَّا تَزَوَّجَ النَّبِيُّ صلى الله عليه وسلم زَيْنَبَ",
    "kind": "narration"
  },
  {
    "id": "caca965d-9cfd-49b1-b9d8-58429c4b7f65",
    "url": "https://sunnah.com/bukhari:6240",
    "start": "قَالَتْ كَانَ عُمَرُ بْنُ الْخَطَّابِ",
    "kind": "companion_words"
  },
  {
    "id": "c374b628-2492-46c3-8c42-dad5b5d519b0",
    "url": "https://sunnah.com/bukhari:6242",
    "start": "أَنَّ رَجُلاً، اطَّلَعَ مِنْ بَعْضِ حُجَرِ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "9783ee09-87d5-48da-bd35-9030366dffff",
    "url": "https://sunnah.com/bukhari:6244",
    "start": "أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم كَانَ إِذَا سَلَّمَ",
    "kind": "narration"
  },
  {
    "id": "e33a78ab-b146-4baa-a418-f6c59fc9a178",
    "url": "https://sunnah.com/bukhari:6245",
    "start": "قَالَ كُنْتُ فِي مَجْلِسٍ مِنْ مَجَالِسِ الأَنْصَارِ",
    "kind": "dialogue"
  },
  {
    "id": "241236b8-1fd9-4eb7-b784-92612851a958",
    "url": "https://sunnah.com/bukhari:6247",
    "start": "أَنَّهُ مَرَّ عَلَى صِبْيَانٍ فَسَلَّمَ عَلَيْهِمْ",
    "kind": "companion_words"
  },
  {
    "id": "fe5ec52a-e4a1-4cdf-af5d-cc87370a7998",
    "url": "https://sunnah.com/bukhari:6248",
    "start": "قَالَ كُنَّا نَفْرَحُ يَوْمَ الْجُمُعَةِ",
    "kind": "companion_words"
  },
  {
    "id": "8d109282-e4fd-4cf3-8910-ac858574777a",
    "url": "https://sunnah.com/bukhari:6250",
    "start": "يَقُولُ أَتَيْتُ النَّبِيَّ صلى الله عليه وسلم فِي دَيْنٍ",
    "kind": "dialogue"
  },
  {
    "id": "c88ee772-1df5-439b-b87a-1285944a9794",
    "url": "https://sunnah.com/bukhari:6251",
    "start": "أَنَّ رَجُلاً، دَخَلَ الْمَسْجِدَ وَرَسُولُ اللَّهِ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "a70ab1dd-8fa1-48f6-8b82-4f715b4ac809",
    "url": "https://sunnah.com/bukhari:6255",
    "start": "قَالَ سَمِعْتُ كَعْبَ بْنَ مَالِكٍ",
    "kind": "companion_words"
  },
  {
    "id": "c8240b95-b83d-4a68-a82b-ecb1cb154016",
    "url": "https://sunnah.com/bukhari:6256",
    "start": "قَالَتْ دَخَلَ رَهْطٌ مِنَ الْيَهُودِ عَلَى رَسُولِ اللَّهِ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "08b04834-027f-4b55-83a3-0c2d18d3c000",
    "url": "https://sunnah.com/bukhari:6259",
    "start": "قَالَ بَعَثَنِي رَسُولُ اللَّهِ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "1eec5d38-92bb-4236-a5d4-2c795c3b52b2",
    "url": "https://sunnah.com/bukhari:6262",
    "start": "أَنَّ أَهْلَ، قُرَيْظَةَ نَزَلُوا عَلَى حُكْمِ سَعْدٍ",
    "kind": "dialogue"
  },
  {
    "id": "8d182ac7-3284-42ec-bccd-f044ec7a75f8",
    "url": "https://sunnah.com/bukhari:6263",
    "start": "قَالَ قُلْتُ لأَنَسٍ أَكَانَتِ الْمُصَافَحَةُ",
    "kind": "dialogue"
  },
  {
    "id": "23654fec-4e32-4f5d-882c-359ac3e5f791",
    "url": "https://sunnah.com/bukhari:6264",
    "start": "قَالَ كُنَّا مَعَ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "f8940a8d-7d8b-4017-ad58-2e421b81d0ee",
    "url": "https://sunnah.com/bukhari:6265",
    "start": "يَقُولُ عَلَّمَنِي رَسُولُ اللَّهِ صلى الله عليه وسلم",
    "kind": "prophet_words"
  },
  {
    "id": "e6bc8c3a-03bb-4de3-a5b0-08482d197c5b",
    "url": "https://sunnah.com/bukhari:6266",
    "start": "أَنَّ عَلِيًّا ـ يَعْنِي ابْنَ أَبِي طَالِبٍ ـ خَرَجَ مِنْ عِنْدِ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "a5a6ffad-1838-4b93-8559-e2c779a0cbf5",
    "url": "https://sunnah.com/bukhari:6267",
    "start": "قَالَ أَنَا رَدِيفُ النَّبِيِّ، صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "8b9d363d-dec5-4360-ae37-59e94c6c5471",
    "url": "https://sunnah.com/bukhari:6268",
    "start": "بِالرَّبَذَةِ كُنْتُ أَمْشِي مَعَ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "e3f168b6-9bd0-4046-8169-25df76a8ef58",
    "url": "https://sunnah.com/bukhari:6270",
    "start": "عَنِ النَّبِيِّ صلى الله عليه وسلم أَنَّهُ نَهَى",
    "kind": "prophet_words"
  },
  {
    "id": "24e83b64-30ad-4fcc-9a01-9035cfc315b1",
    "url": "https://sunnah.com/bukhari:6271",
    "start": "قَالَ لَمَّا تَزَوَّجَ رَسُولُ اللَّهِ صلى الله عليه وسلم زَيْنَبَ",
    "kind": "companion_words"
  },
  {
    "id": "14cf9b0b-f598-4cce-bb8c-cf4f88979864",
    "url": "https://sunnah.com/bukhari:6272",
    "start": "قَالَ رَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "fd7aa139-3635-438d-8715-e3171d90d70b",
    "url": "https://sunnah.com/bukhari:6273",
    "start": "قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏\"‏ أَلاَ أُخْبِرُكُمْ",
    "kind": "prophet_words"
  },
  {
    "id": "8d7c71e1-7f0d-479e-ba61-d9bfa775f8a9",
    "url": "https://sunnah.com/bukhari:6274",
    "start": "وَكَانَ مُتَّكِئًا فَجَلَسَ فَقَالَ ‏\"‏ أَلاَ وَقَوْلُ الزُّورِ",
    "kind": "prophet_words"
  },
  {
    "id": "d398a647-8814-454e-8eba-1bfabd3ced15",
    "url": "https://sunnah.com/bukhari:6275",
    "start": "قَالَ صَلَّى النَّبِيُّ صلى الله عليه وسلم الْعَصْرَ",
    "kind": "narration"
  },
  {
    "id": "7d2debde-db28-4f1e-a8c6-382911aa4c8a",
    "url": "https://sunnah.com/bukhari:6276",
    "start": "قَالَتْ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم يُصَلِّي",
    "kind": "narration"
  },
  {
    "id": "267718ad-a01b-4f1d-a0e6-8e84d7201441",
    "url": "https://sunnah.com/bukhari:6277",
    "start": "قَالَ أَخْبَرَنِي أَبُو الْمَلِيحِ",
    "kind": "dialogue"
  },
  {
    "id": "fae340a1-b338-42b0-9f0e-828423c36340",
    "url": "https://sunnah.com/bukhari:6278",
    "start": "أَنَّهُ قَدِمَ الشَّأْمَ",
    "kind": "dialogue"
  },
  {
    "id": "0dd908bf-ce91-4814-a9d2-73ab9d918667",
    "url": "https://sunnah.com/bukhari:6279",
    "start": "قَالَ كُنَّا نَقِيلُ وَنَتَغَدَّى بَعْدَ الْجُمُعَةِ",
    "kind": "companion_words"
  },
  {
    "id": "90b20154-1d13-4727-b68c-c035001326bf",
    "url": "https://sunnah.com/bukhari:6280",
    "start": "قَالَ مَا كَانَ لِعَلِيٍّ اسْمٌ أَحَبَّ إِلَيْهِ مِنْ أَبِي تُرَابٍ",
    "kind": "companion_words"
  },
  {
    "id": "3e20e346-b3c7-4cd4-906b-eeb7f5c0a5c8",
    "url": "https://sunnah.com/bukhari:6281",
    "start": "أَنَّ أُمَّ سُلَيْمٍ، كَانَتْ تَبْسُطُ لِلنَّبِيِّ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "820961ff-5578-4dd6-9ee0-b41af865af0a",
    "url": "https://sunnah.com/bukhari:6282",
    "start": "أَنَّهُ سَمِعَهُ يَقُولُ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم",
    "kind": "narration"
  },
  {
    "id": "58b33085-a4d1-4060-a2df-72a42339ef7b",
    "url": "https://sunnah.com/bukhari:6284",
    "start": "قَالَ نَهَى النَّبِيُّ صلى الله عليه وسلم عَنْ لِبْسَتَيْنِ",
    "kind": "prophet_words"
  },
  {
    "id": "d5c710a6-63df-4e5c-bd5a-6ab2fbb6f3b6",
    "url": "https://sunnah.com/bukhari:6285",
    "start": "قَالَتْ إِنَّا كُنَّا أَزْوَاجَ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "dialogue"
