    "start": "قَالَ قَالَ أَبُو طَلْحَةَ",
    "kind": "dialogue"
  },
  {
    "id": "5048f8fd-4b7b-4b51-9e0c-630da56ed7aa",
    "url": "https://sunnah.com/bukhari:6691",
    "start": "تَزْعُمُ أَنَّ النَّبِيَّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "0fa827ff-50ff-4ce7-b6ec-e312f00b2de6",
    "url": "https://sunnah.com/bukhari:6698",
    "start": "أَنَّ سَعْدَ بْنَ عُبَادَةَ",
    "kind": "dialogue"
  },
  {
    "id": "22d5911c-ae31-448f-beef-1c3e487da876",
    "url": "https://sunnah.com/bukhari:6699",
