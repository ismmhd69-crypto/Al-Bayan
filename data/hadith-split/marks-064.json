  {
    "id": "53171324-33db-44a2-9ef2-f549827839ab",
    "url": "https://sunnah.com/bukhari:6596",
    "start": "قَالَ رَجُلٌ يَا رَسُولَ اللَّهِ",
    "kind": "dialogue"
  },
  {
    "id": "b53fb968-12f9-42cd-b96f-3edb004f26cc",
    "url": "https://sunnah.com/bukhari:6598",
    "start": "يَقُولُ سُئِلَ رَسُولُ اللَّهِ",
    "kind": "dialogue"
  },
  {
    "id": "d6dc33ae-c076-429c-b5dd-14147f7f9988",
    "url": "https://sunnah.com/bukhari:6604",
    "start": "قَالَ لَقَدْ خَطَبَنَا النَّبِيُّ",
    "kind": "companion_words"
  },
  {
    "id": "120fc40c-d1aa-4723-9857-e5fa3cb62b9d",
    "url": "https://sunnah.com/bukhari:6605",
    "start": "قَالَ كُنَّا جُلُوسًا مَعَ النَّبِيِّ",
    "kind": "dialogue"
  },
  {
    "id": "25877fb0-9e1d-4b3b-9fe8-8ef614e41dbf",
    "url": "https://sunnah.com/bukhari:6606",
    "start": "قَالَ شَهِدْنَا مَعَ رَسُولِ اللَّهِ",
    "kind": "dialogue"
  },
  {
    "id": "1a6edb7d-b332-469c-8801-739db26a6e61",
    "url": "https://sunnah.com/bukhari:6607",
    "start": "أَنَّ رَجُلاً، مِنْ أَعْظَمِ الْمُسْلِمِينَ",
    "kind": "narration"
  },
  {
    "id": "41a781e8-121f-4f4a-b17a-87be560dc0e7",
    "url": "https://sunnah.com/bukhari:6610",
    "start": "قَالَ كُنَّا مَعَ رَسُولِ اللَّهِ",
    "kind": "companion_words"
  },
  {
    "id": "0eaf0cf5-9d06-4446-9895-26c5e26bbf2d",
    "url": "https://sunnah.com/bukhari:6613",
    "start": "قَالَ هِيَ رُؤْيَا عَيْنٍ",
    "kind": "companion_words"
  },
  {
    "id": "f7bd58e3-4d58-4605-a557-7888750b19bc",
    "url": "https://sunnah.com/bukhari:6614",
    "start": "قَالَ ‏\"‏ احْتَجَّ آدَمُ وَمُوسَى",
    "kind": "dialogue"
  },
  {
    "id": "80943e09-fa18-4497-8490-04d8aafcd5e5",
    "url": "https://sunnah.com/bukhari:6617",
    "start": "قَالَ كَثِيرًا مِمَّا كَانَ النَّبِيُّ",
    "kind": "prophet_words"
  },
  {
    "id": "140a79fd-48f9-4590-b96e-624c199a2315",
    "url": "https://sunnah.com/bukhari:6618",
    "start": "قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "a920b892-2ff5-416a-8d66-baa6c162c44a",
    "url": "https://sunnah.com/bukhari:6621",
    "start": "أَنَّ أَبَا بَكْرٍ ـ رضى الله عنه ـ لَمْ يَكُنْ",
    "kind": "companion_words"
  },
  {
    "id": "a8219e56-c549-4852-a340-c18579a48310",
    "url": "https://sunnah.com/bukhari:6623",
    "start": "قَالَ أَتَيْتُ النَّبِيَّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "f5753c3e-047e-481e-9660-dd8a5469b383",
    "url": "https://sunnah.com/bukhari:6632",
    "start": "قَالَ كُنَّا مَعَ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "b626bc04-8121-48d3-8291-affaf04a9a0c",
    "url": "https://sunnah.com/bukhari:6633",
    "start": "أَنَّ رَجُلَيْنِ اخْتَصَمَا إِلَى رَسُولِ اللَّهِ",
    "kind": "dialogue"
  },
  {
    "id": "e7d14f99-8bac-48e9-a6b9-9055e7194553",
    "url": "https://sunnah.com/bukhari:6635",
    "start": "عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏\"‏ أَرَأَيْتُمْ",
    "kind": "prophet_words"
  },
  {
    "id": "56e46d81-314d-4a82-b044-a004fe28bd03",
    "url": "https://sunnah.com/bukhari:6636",
    "start": "أَنَّهُ أَخْبَرَهُ أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم",
    "kind": "companion_words"
  },
  {
    "id": "23c6a221-e1dc-4226-ae72-279345767a1a",
    "url": "https://sunnah.com/bukhari:6638",
    "start": "قَالَ انْتَهَيْتُ إِلَيْهِ",
    "kind": "prophet_words"
  },
  {
    "id": "affb0c81-ea14-42c3-ac1a-88bb398e1163",
    "url": "https://sunnah.com/bukhari:6640",
    "start": "قَالَ أُهْدِيَ إِلَى النَّبِيِّ",
    "kind": "companion_words"
  },
  {
    "id": "46c01ac6-d0a4-4d9a-b522-483c6c108381",
    "url": "https://sunnah.com/bukhari:6641",
    "start": "قَالَتْ إِنَّ هِنْدَ بِنْتَ عُتْبَةَ",
    "kind": "dialogue"
  },
  {
    "id": "e72ae427-d668-4929-8f4e-1ad441aafeba",
    "url": "https://sunnah.com/bukhari:6642",
    "start": "قَالَ بَيْنَمَا رَسُولُ اللَّهِ",
    "kind": "companion_words"
  },
  {
    "id": "4096cde4-6b92-4fed-b30c-daff801ce874",
    "url": "https://sunnah.com/bukhari:6649",
    "start": "قَالَ كَانَ بَيْنَ هَذَا الْحَىِّ",
    "kind": "narration"
  },
  {
    "id": "23d4a67c-a107-4092-92a1-eb021df003cd",
    "url": "https://sunnah.com/bukhari:6651",
    "start": "أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم اصْطَنَعَ",
    "kind": "companion_words"
  },
  {
    "id": "e64710c4-43d5-4307-9680-9c2700541c50",
    "url": "https://sunnah.com/bukhari:6654",
    "start": "عَنِ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "companion_words",
    "tail_start": "وَحَدَّثَنِي مُحَمَّدُ بْنُ بَشَّارٍ، حَدَّثَنَا غُنْدَرٌ، حَدَّثَنَا شُعْبَةُ، عَنْ أَشْعَثَ، عَنْ مُعَاوِيَةَ بْنِ سُوَيْدِ بْنِ مُقَرِّنٍ، عَنِ الْبَرَاءِ ـ رضى الله عنه ـ قَالَ أَمَرَنَا النَّبِيُّ صلى الله عليه وسلم بِإِبْرَارِ الْمُقْسِمِ‏.‏"
  },
  {
    "id": "81961f28-bf51-41e6-bfca-ca02648e1fb1",
    "url": "https://sunnah.com/bukhari:6655",
    "start": "أَرْسَلَتْ إِلَيْهِ وَمَعَ رَسُولِ اللَّهِ",
    "kind": "dialogue"
  },
  {
    "id": "5be00c77-a708-4c1c-abf8-c681581a8640",
    "url": "https://sunnah.com/bukhari:6662",
    "start": "قَالَ سَمِعْتُ عُرْوَةَ بْنَ الزُّبَيْرِ",
    "kind": "dialogue"
  },
  {
    "id": "81aca0ac-7cd1-41a1-95a2-1e5ede4b5f78",
    "url": "https://sunnah.com/bukhari:6663",
    "start": "قَالَتْ أُنْزِلَتْ فِي قَوْلِهِ",
    "kind": "dialogue"
  },
  {
    "id": "f64402bc-d7b6-4640-ba31-38bb0ebc9169",
    "url": "https://sunnah.com/bukhari:6665",
    "start": "أَنَّ النَّبِيَّ صلى الله عليه وسلم بَيْنَمَا هُوَ",
    "kind": "dialogue"
  },
  {
    "id": "95a718de-4180-4889-b5f7-85102a4c13e5",
    "url": "https://sunnah.com/bukhari:6666",
    "start": "قَالَ قَالَ رَجُلٌ لِلنَّبِيِّ",
    "kind": "dialogue"
  },
  {
    "id": "6077a196-740c-42ba-a04e-63f3bc4e417e",
    "url": "https://sunnah.com/bukhari:6667",
    "start": "أَنَّ رَجُلاً، دَخَلَ الْمَسْجِدَ",
    "kind": "dialogue"
  },
  {
    "id": "0bb271c7-eeaa-46d0-8ba4-1a0545f99ac8",
    "url": "https://sunnah.com/bukhari:6668",
    "start": "قَالَتْ هُزِمَ الْمُشْرِكُونَ",
    "kind": "companion_words"
  },
  {
    "id": "fef640ec-7b4b-4bff-bba2-04127359e718",
    "url": "https://sunnah.com/bukhari:6670",
    "start": "قَالَ صَلَّى بِنَا النَّبِيُّ",
    "kind": "prophet_words"
  },
  {
    "id": "300a190f-9d6f-4e2a-98ae-b76dae79026c",
    "url": "https://sunnah.com/bukhari:6671",
    "start": "أَنَّ نَبِيَّ اللَّهِ صلى الله عليه وسلم صَلَّى",
    "kind": "prophet_words"
  },
  {
    "id": "6c21fa64-ffe0-47ba-a943-1043f3fb6c61",
    "url": "https://sunnah.com/bukhari:6673",
    "start": "قَالَ قَالَ الْبَرَاءُ بْنُ عَازِبٍ",
    "kind": "companion_words"
  },
  {
    "id": "1e16941d-7ea9-4b0e-9903-88d9538b0f8e",
    "url": "https://sunnah.com/bukhari:6676",
    "start": "قَالَ قَالَ رَسُولُ اللَّهِ",
