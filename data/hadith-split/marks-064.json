  },
  {
    "id": "2ee54be1-8e9b-4350-a20a-a9b878ee6117",
    "url": "https://sunnah.com/bukhari:6679",
    "start": "عَنْ حَدِيثِ، عَائِشَةَ زَوْجِ النَّبِيِّ صلى الله عليه وسلم",
    "kind": "dialogue"
  },
  {
    "id": "845d333e-4d63-4c29-b770-da4416bab3a5",
    "url": "https://sunnah.com/bukhari:6684",
    "start": "قَالَ آلَى رَسُولُ اللَّهِ",
    "kind": "narration"
  },
  {
    "id": "9c0faf21-b730-4149-b374-49b9a555e54f",
    "url": "https://sunnah.com/bukhari:6685",
