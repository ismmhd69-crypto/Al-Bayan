          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "other_views": []
    },
    "en": {
      "direct_answer": [
        {
          "text": "The Quran gives men and women the same basic standing in faith, good deeds, and reward before God.",
          "source_ids": [
            "Q33:35"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "It promises a good life and reward to anyone who combines faith with good deeds, whether male or female.",
          "source_ids": [
