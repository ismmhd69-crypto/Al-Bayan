  "answers": {
    "ar": {
      "direct_answer": [
        {
          "text": "يجيب القرآن بوضوح بأن الجن والإنس خُلقوا لعبادة الله.",
          "source_ids": [
            "Q51:56"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "والحياة اختبار تظهر فيه جودة أعمال الناس، ولذلك تجمع غايتها بين عبادة الله والعمل الصالح.",
          "source_ids": [
            "Q67:2",
            "Q2:21"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "other_views": []
    },
    "en": {
      "direct_answer": [
        {
          "text": "The Quran gives a clear answer: jinn and human beings were created to worship Allah.",
          "source_ids": [
            "Q51:56"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Life is also a test that reveals the quality of people’s deeds, so its purpose joins worship of Allah with righteous action.",
          "source_ids": [
            "Q67:2",
            "Q2:21"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "other_views": []
    },
    "de": {
      "direct_answer": [
        {
          "text": "Der Koran gibt eine klare Antwort: Dschinn und Menschen wurden erschaffen, um Allah zu dienen.",
          "source_ids": [
            "Q51:56"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Das Leben ist zugleich eine Prüfung, in der sich die Qualität der Taten zeigt, sein Sinn verbindet daher die Anbetung Allahs mit rechtschaffenem Handeln.",
