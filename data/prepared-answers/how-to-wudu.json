      "scholar_id": "ibn-baz",
      "title": "بيان كيفية الوضوء والصلاة",
      "reference": "binbaz.org.sa, fatwa 4022",
      "arabic": "فيشرع للمتوضئ أن يسمي الله في أول الوضوء، وقد أوجب ذلك بعض أهل العلم مع الذكر، فإن نسي أو جهل فلا حرج، ثم يتمضمض ويستنشق ثلاث مرات، ويغسل وجهه ثلاثا، ثم يغسل يديه مع المرفقين ثلاثا يبدأ باليمنى ثم اليسرى، ثم يمسح رأسه وأذنيه مرة واحدة، ثم يغسل رجليه مع الكعبين ثلاث مرات يبدأ باليمنى وإن اقتصر على مرة أو مرتين فلا بأس؛ لأن النبي ﷺ توضأ مرة مرة ومرتين مرتين وثلاثا ثلاثا، وربما غسل بعض أعضائه مرتين وبعضها ثلاثا، وذلك يدل على أن الأمر فيه سعة والحمد لله، لكن التثليث أفضل.",
      "url": "https://binbaz.org.sa/fatwas/4022/%D8%A8%D9%8A%D8%A7%D9%86-%D9%83%D9%8A%D9%81%D9%8A%D8%A9-%D8%A7%D9%84%D9%88%D8%B6%D9%88%D8%A1-%D9%88%D8%A7%D9%84%D8%B5%D9%84%D8%A7%D8%A9"
    }
  ],
  "answers": {
    "ar": {
      "direct_answer": [
        {
          "text": "يكون الوضوء بترتيب الأعضاء مع إسباغ غسلها.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003",
            "Q5:6"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "ابدأ بذكر اسم الله.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "تمضمض واستنشق الماء.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "اغسل وجهك.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "اغسل يديك مع المرفقين وابدأ باليمين.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "امسح رأسك وأذنيك مرة واحدة.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "اغسل رجليك مع الكعبين وابدأ باليمين.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "en": {
      "direct_answer": [
        {
          "text": "Wudu is performed by washing and wiping the required parts in order.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003",
            "Q5:6"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Begin by mentioning Allah's name.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Rinse your mouth and nose.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Wash your face.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Wash your arms through the elbows, starting with the right.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Wipe your head and ears once.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Wash your feet through the ankles, starting with the right.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "de": {
      "direct_answer": [
        {
          "text": "Der Wudu wird ausgeführt, indem die vorgeschriebenen Körperteile der Reihe nach gewaschen oder gestrichen werden.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003",
            "Q5:6"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Beginne mit der Nennung von Allahs Namen.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Spüle Mund und Nase.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Wasche dein Gesicht.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Wasche die Arme samt Ellbogen, beginnend mit dem rechten.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Streiche einmal über Kopf und Ohren.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Wasche die Füße samt Knöcheln, beginnend mit dem rechten.",
          "source_ids": [
            "S40220000-0000-4000-a000-000000000003"
          ],
          "requirement_id": "R1"
        }
      ]
    }
  }
}
