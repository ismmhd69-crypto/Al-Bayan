  "sources": [
    {
      "id": "S10034000-0000-4000-a000-000000000001",
      "kind": "scholar",
      "scholar_id": "ibn-baz",
      "title": "صفة حج المفرد",
      "reference": "binbaz.org.sa, fatwa 10034",
      "arabic": "فتذهب إلى مكة وقت الحج، تطوف وتسعى، وتبقى على إحرامك، حتى تقف في عرفات حتى ترمي جمرة العقبة. فإذا رميت جمرة العقبة؛ فالأفضل أن تحلق، وإن قصَّرت؛ فلا بأس، ثم تحل، ومن حل بعد الرمي؛ أجزأه، لكن الأفضل أن يكون بعد الحلق، بعد الرمي والحلق، أو التقصير، ثم يلبس ثيابه إذا شاء، ويتطيب إذا شاء، ثم يطوف ويسعى طوافًا بالبيت سبعة أشواط، ويصلي ركعتين، ثم يسعى بين الصفا والمروة سبعة أشواط، هذا هو الحج المفرد ما فيه هدي",
      "url": "https://binbaz.org.sa/fatwas/10034/%D8%B5%D9%81%D8%A9-%D8%AD%D8%AC-%D8%A7%D9%84%D9%85%D9%81%D8%B1%D8%AF"
    }
  ],
  "answers": {
    "ar": {
      "direct_answer": [
        {
          "text": "تصف هذه الفتوى ترتيب حج الإفراد.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "أحرم من الميقات وتوجه إلى مكة.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "طف بالبيت ثم اسع بين الصفا والمروة.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "ابق على إحرامك حتى تقف بعرفة.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "ارم جمرة العقبة يوم النحر.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "احلق أو قصر ثم تحلل من الإحرام.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "اختم بطواف سبعة أشواط ثم سعي سبعة أشواط.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "en": {
      "direct_answer": [
        {
          "text": "This fatwa gives the order of Hajj al-Ifrad.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Enter Ihram at the Miqat and proceed to Mecca.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Perform Tawaf and then Sa'i between Safa and Marwah.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Remain in Ihram until standing at Arafat.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Stone the Jamrah of Aqabah on the Day of Sacrifice.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Shave or trim the hair and leave Ihram.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Complete seven circuits of Tawaf and then seven rounds of Sa'i.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "de": {
      "direct_answer": [
        {
          "text": "Diese Fatwa nennt die Reihenfolge des Hadsch al-Ifrad.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Tritt am Miqat in den Ihram ein und begib dich nach Mekka.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Vollziehe den Tawaf und danach den Sa'i zwischen Safa und Marwa.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Bleibe bis zum Aufenthalt in Arafat im Ihram.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Bewirf am Opfertag die Jamrah von Aqabah.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Rasiere oder kürze das Haar und verlasse den Ihram.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Schließe mit sieben Tawaf-Runden und danach sieben Sa'i-Runden ab.",
          "source_ids": [
            "S10034000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ]
    }
  }
}
