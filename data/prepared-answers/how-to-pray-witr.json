  "sources": [
    {
      "id": "S51290000-0000-4000-a000-000000000001",
      "kind": "scholar",
      "scholar_id": "ibn-baz",
      "title": "ما صفة صلاة الوتر ووقتها وعدد ركعاتها؟",
      "reference": "binbaz.org.sa, fatwa 5129",
      "arabic": "صلاة الوتر سنة قربة متأكدة، تبدأ بعد صلاة العشاء وتنتهي بطلوع الفجر هذه صلاة الوتر، تبدأ بعد صلاة العشاء وتنتهي بطلوع الفجر، وأقلها ركعة واحدة، هذا أقلها، وأفضلها إحدى عشرة ركعة أو ثلاثة عشرة ركعة لفعل النبي ﷺ، وإن زاد على ذلك فأوتر بخمس عشرة أو بعشرين مع الوتر أو ما أشبه ذلك فلا بأس فلا حرج؛ لأن النبي ﷺ قال: صلاة الليل مثنى مثنى، فإذا خشي أحدكم الصبح صلى ركعة واحدة توتر له ما قد صلى ولم يحد حداً",
      "url": "https://binbaz.org.sa/fatwas/5129/%D9%85%D8%A7-%D8%B5%D9%81%D8%A9-%D8%B5%D9%84%D8%A7%D8%A9-%D8%A7%D9%84%D9%88%D8%AA%D8%B1-%D9%88%D9%88%D9%82%D8%AA%D9%87%D8%A7-%D9%88%D8%B9%D8%AF%D8%AF-%D8%B1%D9%83%D8%B9%D8%A7%D8%AA%D9%87%D8%A7%D8%9F"
    }
  ],
  "answers": {
    "ar": {
      "direct_answer": [
        {
          "text": "الوتر سنة مؤكدة من صلاة الليل.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "صل الوتر بعد العشاء وقبل طلوع الفجر.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "صل صلاة الليل ركعتين ركعتين.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "اختم ما صليته بركعة واحدة تجعل العدد وترًا.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "يجزئ في الوتر ركعة واحدة، والأفضل إحدى عشرة أو ثلاث عشرة ركعة.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "en": {
      "direct_answer": [
        {
          "text": "Witr is an emphasized Sunnah prayer at night.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Pray Witr after Isha and before dawn.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Pray the night prayer in sets of two rak'ahs.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Finish with one rak'ah so the total becomes odd.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "One rak'ah is sufficient, while eleven or thirteen is preferable.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "de": {
      "direct_answer": [
        {
          "text": "Witr ist ein nachdrücklich empfohlenes Gebet in der Nacht.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Bete Witr nach dem Ischa-Gebet und vor der Morgendämmerung.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Bete das Nachtgebet jeweils in zwei Rak'ahs.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Schließe mit einer Rak'ah ab, damit die Gesamtzahl ungerade wird.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Eine Rak'ah genügt, während elf oder dreizehn vorzuziehen sind.",
          "source_ids": [
            "S51290000-0000-4000-a000-000000000001"
          ],
          "requirement_id": "R1"
        }
      ]
    }
  }
}
