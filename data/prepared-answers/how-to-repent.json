  "sources": [
    {
      "id": "S0772d6ef-b31d-477f-b827-d1c22b506d95",
      "kind": "scholar",
      "scholar_id": "ibn-baz",
      "title": "فضل الاستغفار وشروط التوبة",
      "reference": "binbaz.org.sa, fatwa 17964",
      "arabic": "والتوبة الصادقة تشتمل على ثلاثة أمور: الأمر الأول: الإقلاع من الذنوب وتركها طاعة لله، وتعظيمًا له. الأمر الثاني: الندم على ما مضى منها، الأسف والحزن على ما مضى منها. الأمر الثالث: العزيمة الصادقة ألا يعود فيها، فإذا تاب هذه التوبة كفر الله خطاياه مطلقًا كبيرة أو صغيرة. وهناك شرط رابع إذا كانت المعصية تتعلق بحق المخلوقين فلا بد من رد الحق إلى أهله إذا كان دين أو ظلامة يعني أخذ مال لإنسان أو سرقة، أو ما أشبه ذلك، لا بد من رد المال إلى مستحقه، أو تحلله من ذلك.",
      "url": "https://binbaz.org.sa/fatwas/17964/%D9%81%D8%B6%D9%84-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%BA%D9%81%D8%A7%D8%B1-%D9%88%D8%B4%D8%B1%D9%88%D8%B7-%D8%A7%D9%84%D8%AA%D9%88%D8%A8%D8%A9"
    }
  ],
  "answers": {
    "ar": {
      "direct_answer": [
        {
          "text": "للتوبة الصادقة شروط عملية ينبغي جمعها.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "اترك المعصية فورًا.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "استشعر الندم على ما وقع.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "اعزم بصدق على عدم الرجوع إليها.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "أعد حقوق الناس إليهم أو اطلب منهم المسامحة إذا تعلقت المعصية بحقوقهم.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "en": {
      "direct_answer": [
        {
          "text": "Sincere repentance requires practical conditions that must be brought together.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Stop committing the sin.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Feel genuine remorse for it.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Resolve sincerely not to return to it.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Restore another person's rights or seek their pardon when the sin concerns them.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        }
      ]
    },
    "de": {
      "direct_answer": [
        {
          "text": "Aufrichtige Reue verlangt mehrere praktische Bedingungen.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        }
      ],
      "explanation": [],
      "list": [
        {
          "text": "Beende die Sünde.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Empfinde ehrliche Reue darüber.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Entschließe dich aufrichtig, nicht zu ihr zurückzukehren.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        },
        {
          "text": "Gib Rechte anderer zurück oder bitte sie um Verzeihung, wenn die Sünde ihre Rechte betrifft.",
          "source_ids": [
            "S0772d6ef-b31d-477f-b827-d1c22b506d95"
          ],
          "requirement_id": "R1"
        }
      ]
    }
  }
}
