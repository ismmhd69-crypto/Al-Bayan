# Copy this file to .env and fill in the empty values yourself. Never commit .env.

# Supabase (Frankfurt). URL and publishable key are safe to share.
NEXT_PUBLIC_SUPABASE_URL=https://jnietkyxgnocyizvjiel.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9q-WCH8kR4E31ywcDhSIVw_fqm4FLP8
# Secret: Supabase dashboard > Project Settings > API keys
SUPABASE_SECRET_KEY=

# Secret: aistudio.google.com > Get API key (use the paid tier, not free)
GEMINI_API_KEY=
# Vertex AI key (optional, not used since 2026-09-29), bound to a service account with the Vertex AI User role
VERTEX_API_KEY=

# Secret: requested via github.com/sunnah-com/api issues
SUNNAH_API_KEY=

# Secret: api-docs.quran.foundation
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=

# Secret: Google Cloud > YouTube Data API v3
YOUTUBE_API_KEY=

# Not secrets. Automatic answers stay off unless ASK_ENABLED=true (local testing only for now).
ASK_ENABLED=false
# Experimental per-claim meaning/context audit. Keep off until model evaluation passes.
ASK_CLAIM_AUDIT=false

# Internal prepared-answer approvals stay disabled unless this private value is set to at least
# 32 random characters. Never expose it through a NEXT_PUBLIC variable.
BAYAN_REVIEW_KEY=
BAYAN_REVIEW_ENABLED=false

# Keep public prepared answers off until the review RPC lock migration is applied and verified.
PREPARED_PUBLISHING_ENABLED=false
# AI_PROVIDER: "gemini" (Vertex was dropped 2026-09-29 for cost; the vertex door stays in code if VERTEX_API_KEY is ever set)
# AI_PROVIDER=gemini
# Model chains, most preferred first, comma separated. When a model is busy (429/503) the next one is tried.
# The writer chain and the verifier chain must not share a model.
# An entry is "model" or "provider:model" (providers: gemini, vertex, nvidia, openrouter). NVIDIA_API_KEY and OPENROUTER_API_KEY enable their entries.
# OpenRouter is the MAIN AI door whenever OPENROUTER_API_KEY is set (Mo, 2026-10-04): with no AI_MODELS set, the
# writer is google/gemini-3.5-flash-lite (then google/gemini-3.8-flash) and the checker is google/gemini-3.1-flash-lite
# (then mistralai/mistral-small-3.2-24b-instruct). Without the key the old direct Gemini defaults apply.
# Prompts only go to providers that do not keep or
# train on them; a model with no such provider counts as busy and the chain moves on.
# AI_MODELS=openrouter:qwen/qwen3-235b-a22b-2507
# AI_VERIFIER_MODELS=openrouter:mistralai/mistral-small-3.2-24b-instruct
# OPENROUTER_API_KEY=
# OPENROUTER_TIMEOUT_MS=25000  per call; a timeout counts as busy and the chain moves on
# OPENROUTER_RPM=100           requests a minute per model
# OPENROUTER_DAILY_LIMIT=1000  requests a day per model, per server instance
# OPENROUTER_PRIVACY=zdr       zdr (default: no logging, no training) | deny (no training) | off (never for visitors)
# OPENROUTER_SORT=             throughput | latency | price: pick the provider in that order (default: OpenRouter balances)
# OPENROUTER_REASONING=low     low (default; Gemini 3.5 Flash-Lite cannot switch thinking off) | off | medium | high | default
# OPENROUTER_STRUCTURED_OUTPUTS=false  opt-in schema request + local shape checks; no 400 downgrade; real-route acceptance pending
# AI_MODELS=gemini-3.7-flash
# AI_VERIFIER_MODELS=gemini-3.1-flash-lite
# NVIDIA mix (opt-in, see docs/nvidia-switch-report.md). NVIDIA's free endpoint is for development
# and testing only; questions are sent to NVIDIA when it is used. Gemini stays last as the fallback.
# Measured mix (2026-10-02): writer Nemotron with thinking off, checker gpt-oss-20b, lean mode.
# AI_MODELS=nvidia:nvidia/nemotron-3-super-120b-a12b,gemini-3.7-flash
# AI_VERIFIER_MODELS=nvidia:openai/gpt-oss-20b,gemini-3.1-flash-lite
# NVIDIA_API_KEY=
# NVIDIA_TIMEOUT_MS=25000      per call (code default 20000); a timeout counts as busy and the chain moves on
# NVIDIA_RPM=35                requests a minute per model (NVIDIA allows about 40)
# NVIDIA_DAILY_LIMIT=1000      requests a day per model, per server instance
# NVIDIA_REASONING=off         low (default) | off (also switches Nemotron thinking off) | default
# ASK_DEADLINE_MS=50000        whole answer deadline, 10000 to 55000
# ASK_LEAN=true                true = fewer candidates for the evidence check (faster, more refusals)
# ASK_TIERED=true              evidence in Mo's order: Quran, hadith, fatwas, videos (docs/tiered-ask-report.md); unset = old behaviour
# ASK_APPROVED_TOPICS=true     reuse matching approved Hard Questions answers; default on when prepared publishing is on; false disables topic reuse
# ASK_VIDEO_BUDGET_MS=20000    tiered mode: add videos only if the answer was ready within this time (0 = never)
# MAX_VIDEOS=4                 tiered mode: at most this many videos (0 to 4)
# HADITH_SOURCE: "library" uses the stored Sunnah.com hadith (see docs/hadith-ask-report.md).
QURAN_API_ENV=prelive
QURAN_CHAPTERS=1,2
# Hadith source for Ask answers. "hadeethenc" turns on Sahih al-Bukhari / Sahih Muslim hadith
# from HadeethEnc.com (permission requested 2026-09-28). Leave empty to answer from the Quran only.
HADITH_SOURCE=
# Stored hadith card layout (chapter heading, quoted words highlighted, chain folded). On by default;
# HADITH_SPLIT=off shows every hadith as the full-text card. See docs/hadith-card-report.md.
HADITH_SPLIT=
# Scholar quotes in Ask are on when SUPABASE_SECRET_KEY is set; set SCHOLAR_QUOTES=off to disable them.
SCHOLAR_QUOTES=

# Local next dev only: detailed private traces and unhurried Ask processing default on.
# Production/Vercel ignores these local options. See docs/ask-rich-streaming.md.
# ASK_LOCAL_TRACE=false
# ASK_LOCAL_UNHURRIED=false
# ASK_MEANING_RANKING=false   experimental contextual reranking before candidate caps; leave off until preview acceptance
# ASK_FOCUSED_CHECKS=false    separate exact-excerpt support and answer-quality checks; real-model acceptance pending
# ASK_DISTINCT_SELECTION=false    explicit necessary/distinct contributions instead of filling source quotas; acceptance pending
# ASK_RESEARCH_RECOVERY=false experimental gap-specific reformulations, at most two rounds; leave off until preview acceptance
# ASK_CORPUS_RETRIEVAL=false  original-passage discovery preview; current eligibility checks still required
# ASK_CORPUS_BACKEND=local    local filesystem pilot, or explicitly accepted persistent database
# ASK_PERSISTENT_INDEX_ACCEPTED=false  off until remote storage/privacy/eligibility checks pass; does not approve models or content
# ASK_CORPUS_INDEX_DIR=work/private-ask-evaluation/source-index-pilot
# ASK_CORPUS_LEXICAL_PREVIEW=false  explicitly allow a lexical-only pilot; never labelled semantic
# ASK_RICH_VIDEOS=false  approved-channel title suggestions only; no transcript evidence
# ASK_LOCAL_EMBEDDINGS=false  loopback TEI preview only; no model download or hosted provider
# ASK_LOCAL_EMBEDDING_CONFIG=  explicit JSON from docs/ask-local-embedding-preview.md; leave empty until permission/billing/model pilot gates pass
# Research worker preview only. Leave disabled until billing and source review are accepted.
# Requires the prepared job migration; does not extend /api/ask's HTTP lifetime.
# ASK_DURABLE_ENABLED=false
# ASK_PATIENT_ENABLED=false    v2 staged worker; requires durable, rich and worker-acceptance gates
# ASK_JOB_WORKER_ACCEPTED=false
# ASK_JOB_BUILD_REVISION=       actual 40-64 character code/build hash, shared by API and worker
# ASK_JOB_KEY_ID=               stable encryption key version
# ASK_JOB_ENCRYPTION_KEY=       private base64 32-byte key; never NEXT_PUBLIC or regenerated on restart
# ASK_JOB_MAX_DURATION_MS=      legacy v1 finite worker budget, 60000 to 600000; patient v2 has no elapsed answer deadline
# ASK_JOB_MAX_ATTEMPT_USD=      accepted conservative reservation per model HTTP attempt
# ASK_JOB_MAX_COST_USD=         accepted total per-job cap; never more than the preview's $1.50 ceiling
# ASK_JOB_OWNER_SECRET=         separate stable private base64 32-byte cookie/ownership HMAC key
