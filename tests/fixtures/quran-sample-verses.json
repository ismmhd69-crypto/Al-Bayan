      },
      {
        "id": 7,
        "verse_number": 7,
        "verse_key": "1:7",
        "hizb_number": 1,
        "rub_el_hizb_number": 1,
        "ruku_number": 1,
        "manzil_number": 1,
        "sajdah_number": null,
        "text_uthmani": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
        "text_imlaei_simple": "صراط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين",
        "page_number": 1,
        "juz_number": 1,
        "translations": [
          {
            "id": 401710,
            "resource_id": 85,
            "text": "the path of those You have blessed, those who incur no anger and who have not gone astray."
          }
        ]
      }
