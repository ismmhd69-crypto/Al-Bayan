        "hizb_number": 1,
        "rub_el_hizb_number": 1,
        "ruku_number": 1,
        "manzil_number": 1,
        "sajdah_number": null,
        "text_uthmani": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
        "text_imlaei_simple": "اياك نعبد واياك نستعين",
        "page_number": 1,
        "juz_number": 1,
        "translations": [
          {
            "id": 401708,
            "resource_id": 85,
            "text": "It is You we worship; it is You we ask for help."
