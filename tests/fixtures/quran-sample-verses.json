        "hizb_number": 1,
        "rub_el_hizb_number": 1,
        "ruku_number": 1,
        "manzil_number": 1,
        "sajdah_number": null,
        "text_uthmani": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
        "text_imlaei_simple": "اهدنا الصراط المستقيم",
        "page_number": 1,
        "juz_number": 1,
        "translations": [
          {
            "id": 401709,
            "resource_id": 85,
            "text": "Guide us to the straight path:"
